model role {
  id                         BigInt      @id @default(autoincrement())
  code                       String      @unique @db.Char(3)
  name                       String      @db.VarChar(255)
  created_at                 DateTime    @default(now()) @db.Timestamp(6)
  created_by                 BigInt?
  updated_at                 DateTime?   @db.Timestamp(6)
  updated_by                 BigInt?
  deleted_at                 DateTime?   @db.Timestamp(6)
  deleted_by                 BigInt?
  user_role_created_byTouser user?       @relation("role_created_byTouser", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_role_created_by")
  user_role_deleted_byTouser user?       @relation("role_deleted_byTouser", fields: [deleted_by], references: [id], onUpdate: NoAction, map: "fk_role_deleted_by")
  user_role_updated_byTouser user?       @relation("role_updated_byTouser", fields: [updated_by], references: [id], onUpdate: NoAction, map: "fk_role_updated_by")
  user_role                  user_role[]

  @@index([code], map: "idx_role_code")
  @@index([deleted_at], map: "idx_role_deleted_at")
  @@schema("mtr")
}
