model role {
    id         BigInt    @id @default(autoincrement())
    code       String    @unique @db.Char(3)
    name       String
    created_at DateTime  @default(now()) @db.Timestamp()
    created_by BigInt?
    updated_at DateTime?
    updated_by BigInt?
    deleted_at DateTime?
    deleted_by BigInt?

    created_user user? @relation("role_created_by", fields: [created_by], references: [id])
    updated_user user? @relation("role_updated_by", fields: [updated_by], references: [id])
    deleted_user user? @relation("role_deleted_by", fields: [deleted_by], references: [id])

    user_roles user_role[] @relation("user_role_role_id")

    @@schema("mtr")
}
