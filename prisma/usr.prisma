model user_authentication {
  id            BigInt  @id(map: "user_authentication_pk") @default(autoincrement())
  user_id       BigInt  @unique(map: "user_authentication_unique")
  access_token  String  @db.VarChar
  refresh_token String? @unique(map: "user_authentication_unique_1") @db.VarChar
  users         users   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_authentication_user_fk")

  @@schema("usr")
}

model user_detail {
  id           BigInt  @id @default(autoincrement())
  user_id      BigInt  @unique(map: "user_detail_unique")
  avatar       String?
  fullname     String
  address      String?
  phone_number String? @db.VarChar(16)
  users        users   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_detail_user_id")

  @@index([user_id], map: "idx_user_detail_user_id")
  @@schema("usr")
}

model user_password {
  id         BigInt    @id @default(autoincrement())
  password   String
  created_at DateTime  @default(now()) @db.Timestamp(6)
  created_by BigInt?
  updated_at DateTime? @db.Timestamp(6)
  updated_by BigInt?
  deleted_at DateTime? @db.Timestamp(6)
  deleted_by BigInt?
  user_id    BigInt
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_password_user_fk")

  @@unique([password, deleted_at], map: "user_password_unique")
  @@index([deleted_at], map: "idx_user_password_deleted_at")
  @@index([created_by], map: "idx_user_password_user")
  @@index([user_id])
  @@schema("usr")
}

model user_role {
  id      BigInt @id @default(autoincrement())
  user_id BigInt @unique(map: "user_role_unique")
  role_id BigInt
  role    role   @relation(fields: [role_id], references: [id], onUpdate: NoAction, map: "fk_user_role_role")
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_role_user")

  @@unique([user_id, role_id], map: "uq_user_role")
  @@index([role_id], map: "idx_user_role_role_id")
  @@index([user_id], map: "idx_user_role_user_id")
  @@schema("usr")
}

model users {
  id                  BigInt               @id(map: "user_pkey") @default(autoincrement())
  unique_code         String               @unique(map: "user_unique_code_key") @db.Char(30)
  email               String               @db.VarChar(50)
  created_at          DateTime             @default(now()) @db.Timestamp(6)
  created_by          BigInt?
  updated_at          DateTime?            @db.Timestamp(6)
  updated_by          BigInt?
  deleted_at          DateTime?            @db.Timestamp(6)
  deleted_by          BigInt?
  start_at            DateTime             @default(now()) @db.Timestamp(6)
  end_at              DateTime?            @db.Timestamp(6)
  is_active           Boolean              @default(true)
  excel_mappings      excel_mappings[]
  excel_templates     excel_templates[]
  user_authentication user_authentication?
  user_detail         user_detail?
  user_password       user_password[]
  user_role           user_role?

  @@index([deleted_at], map: "idx_user_deleted_at")
  @@schema("usr")
}
