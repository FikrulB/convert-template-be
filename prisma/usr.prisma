model user {
    id          BigInt    @id @default(autoincrement())
    unique_code String    @unique @db.Char(30)
    email       String    @db.VarChar(50)
    created_at  DateTime  @default(now()) @db.Timestamp()
    created_by  BigInt?
    updated_at  DateTime?
    updated_by  BigInt?
    deleted_at  DateTime?
    deleted_by  BigInt?

    created_user user? @relation("user_created_by", fields: [created_by], references: [id])
    updated_user user? @relation("user_updated_by", fields: [updated_by], references: [id])
    deleted_user user? @relation("user_deleted_by", fields: [deleted_by], references: [id])

    created_users user[] @relation("user_created_by")
    updated_users user[] @relation("user_updated_by")
    deleted_users user[] @relation("user_deleted_by")

    created_user_password user_password[] @relation("user_password_created_by")
    updated_user_password user_password[] @relation("user_password_updated_by")
    deleted_user_password user_password[] @relation("user_password_deleted_by")

    created_user_detail user_detail[] @relation("user_detail_created_by")
    updated_user_detail user_detail[] @relation("user_detail_updated_by")
    deleted_user_detail user_detail[] @relation("user_detail_deleted_by")

    user_role user_role[] @relation("user_role_user_id")

    created_role role[] @relation("role_created_by")
    updated_role role[] @relation("role_updated_by")
    deleted_role role[] @relation("role_deleted_by")

    @@schema("usr")
}

model user_password {
    id           BigInt    @id @default(autoincrement())
    old_password String?
    password     String
    created_at   DateTime  @default(now()) @db.Timestamp()
    created_by   BigInt?
    updated_at   DateTime?
    updated_by   BigInt?
    deleted_at   DateTime?
    deleted_by   BigInt?

    created_user user? @relation("user_password_created_by", fields: [created_by], references: [id])
    updated_user user? @relation("user_password_updated_by", fields: [updated_by], references: [id])
    deleted_user user? @relation("user_password_deleted_by", fields: [deleted_by], references: [id])

    @@schema("usr")
}

model user_detail {
    id         BigInt    @id @default(autoincrement())
    user_id    BigInt
    avatar     String?
    fullname   String
    address    String?
    start_at   DateTime
    end_at     DateTime?
    is_active  Boolean   @default(false)
    created_at DateTime  @default(now()) @db.Timestamp()
    created_by BigInt?
    updated_at DateTime?
    updated_by BigInt?
    deleted_at DateTime?
    deleted_by BigInt?

    created_user user? @relation("user_detail_created_by", fields: [created_by], references: [id])
    updated_user user? @relation("user_detail_updated_by", fields: [updated_by], references: [id])
    deleted_user user? @relation("user_detail_deleted_by", fields: [deleted_by], references: [id])

    @@schema("usr")
}

model user_role {
    id      BigInt @id @default(autoincrement())
    user_id BigInt
    role_id BigInt

    user user @relation("user_role_user_id", fields: [user_id], references: [id])
    role role @relation("user_role_role_id", fields: [role_id], references: [id])

    @@schema("usr")
}
