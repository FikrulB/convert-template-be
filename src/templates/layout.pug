doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title #{subject}
    style.
      body {
        font-family: Arial, sans-serif;
        background-color: #f4f6f8;
        padding: 20px;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 8px;
        overflow: hidden;
      }
      .header {
        background: #4f46e5;
        color: #ffffff;
        padding: 16px;
        text-align: center;
        font-size: 20px;
        font-weight: bold;
      }
      .content {
        padding: 24px;
        color: #333333;
        line-height: 1.6;
      }
      .footer {
        padding: 16px;
        font-size: 12px;
        color: #888888;
        text-align: center;
      }
      .btn {
        display: inline-block;
        margin-top: 16px;
        padding: 12px 20px;
        background: #4f46e5;
        color: #ffffff;
        text-decoration: none;
        border-radius: 6px;
      }

  body
    .container
      .header #{appName}
      .content
        block content
      .footer
        | © #{year} #{appName}. All rights reserved.
